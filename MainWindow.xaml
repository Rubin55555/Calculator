<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="900">

    <Grid Background="#00FFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="num1" Grid.Row="1" Grid.Column="0" Height="40" Width="100" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"/>
        <TextBox x:Name="num2" Grid.Row="2" Grid.Column="0" Height="40" Width="100" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"/>

        <TextBlock x:Name="txtResult" Grid.Row="3" Grid.Column="0" Text="תוצאה: " FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Button x:Name="Plus" Content="+" Grid.Column="2" Grid.Row="0" Height="40" Width="40" FontSize="18" Click="Plus_Click"/>
        <Button x:Name="Minus" Content="-" Grid.Column="2" Grid.Row="1" Height="40" Width="40" FontSize="18" Click="Minus_Click"/>
        <Button x:Name="Kaful" Content="*" Grid.Column="2" Grid.Row="2" Height="40" Width="40" FontSize="18" Click="Kaful_Click"/>
        <Button x:Name="Divide" Content="/" Grid.Column="2" Grid.Row="3" Height="40" Width="40" FontSize="18" Click="Divide_Click"/>

        <Button x:Name="AC" Content="AC" Grid.Column="2" Grid.Row="4" Height="40" Width="40" FontSize="16" Click="AC_Click"/>

    </Grid>
</Window>